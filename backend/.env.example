# ---- Database (Supabase Postgres) ----
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543) is the easiest one that works from anywhere,
# no IP allow-listing needed. Paste it here with your real password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ---- Default LLM provider ----
# "anthropic" or "ollama". Can also be overridden per-request from the UI toggle.
DEFAULT_LLM_PROVIDER=GROQ

# ---- Cloud LLM (GROQ) ----
GROQ_API_KEY=your_key_here
GROQ_MODEL=Llama 3.3 70b

# ---- Local LLM (Ollama) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b

# ---- RAG / vector store (Qdrant) ----
# Leave QDRANT_URL empty to use a local on-disk Qdrant (zero setup, good for
# a quick first run). To use Qdrant Cloud instead: create a free cluster at
# https://cloud.qdrant.io, then paste its URL + API key below.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_COLLECTION=lennys_transcripts
